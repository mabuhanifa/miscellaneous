# Staging Environment Configuration
NODE_ENV=staging
PORT=3000
APP_NAME=Bangladesh eCommerce Platform - Staging
APP_URL=https://staging.yourdomain.com

# Database
MONGODB_URI=mongodb://localhost:27017/bangladesh_ecommerce_staging

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=staging-jwt-secret-key-change-this
JWT_REFRESH_SECRET=staging-refresh-secret-key-change-this
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Instance Configuration
INSTANCE_NAME=Staging Store
INSTANCE_DOMAIN=staging.yourdomain.com
INSTANCE_TIMEZONE=Asia/Dhaka
INSTANCE_CURRENCY=BDT
INSTANCE_LANGUAGE=en