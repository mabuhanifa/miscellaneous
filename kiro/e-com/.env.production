# Production Environment Configuration
NODE_ENV=production
PORT=3000
APP_NAME=Bangladesh eCommerce Platform
APP_URL=https://yourdomain.com

# Database
MONGODB_URI=mongodb://localhost:27017/bangladesh_ecommerce_prod

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# JWT Configuration - CHANGE THESE IN PRODUCTION
JWT_SECRET=your-production-jwt-secret-key-must-be-very-secure
JWT_REFRESH_SECRET=your-production-refresh-secret-key-must-be-very-secure
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Instance Configuration
INSTANCE_NAME=Your Store Name
INSTANCE_DOMAIN=yourdomain.com
INSTANCE_TIMEZONE=Asia/Dhaka
INSTANCE_CURRENCY=BDT
INSTANCE_LANGUAGE=en