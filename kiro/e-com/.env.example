# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Application
NODE_ENV=development
PORT=3000
APP_NAME=Bangladesh eCommerce Platform
APP_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/bangladesh_ecommerce_dev
MONGODB_TEST_URI=mongodb://localhost:27017/bangladesh_ecommerce_test

# Redis (Optional - for caching and performance)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_KEY_PREFIX=ecommerce:

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@yourdomain.com

# SMS Configuration (Optional)
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_GATEWAY=

# Payment Gateways (Optional)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_LIVE=false

# Shipping APIs (Optional)
# Pathao Courier
PATHAO_BASE_URL=https://merchant-api.pathao.com/api/v1
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_ENABLED=false

# Paperfly Courier
PAPERFLY_BASE_URL=https://api.paperfly.com.bd/api/v1
PAPERFLY_API_KEY=
PAPERFLY_SECRET_KEY=
PAPERFLY_MERCHANT_ID=
PAPERFLY_ENABLED=false

# eCourier
ECOURIER_BASE_URL=https://backoffice.ecourier.com.bd/api
ECOURIER_USER_ID=
ECOURIER_API_KEY=
ECOURIER_SECRET_KEY=
ECOURIER_ENABLED=false

# Merchant/Pickup Address
MERCHANT_NAME=Your Store Name
MERCHANT_PHONE=01700000000
MERCHANT_ADDRESS=Your Store Address
MERCHANT_DISTRICT=Dhaka
MERCHANT_THANA=Dhanmondi
MERCHANT_POSTAL_CODE=1205

# Shipping Notifications
SEND_TRACKING_NOTIFICATIONS=true
SEND_DELIVERY_CONFIRMATION=true

# Shipping Webhooks
SHIPPING_WEBHOOKS_ENABLED=false
SHIPPING_WEBHOOK_BASE_URL=
SHIPPING_WEBHOOK_SECRET=

# Instance Configuration
INSTANCE_NAME=My Store
INSTANCE_DOMAIN=localhost:3000
INSTANCE_TIMEZONE=Asia/Dhaka
INSTANCE_CURRENCY=BDT
INSTANCE_LANGUAGE=en

# Business Information (for invoices)
BUSINESS_NAME=Your Business Name
BUSINESS_ADDRESS=Your Business Address, City, Country
BUSINESS_PHONE=+880-XXX-XXXXXX
BUSINESS_EMAIL=info@yourbusiness.com
BUSINESS_WEBSITE=www.yourbusiness.com
BUSINESS_LOGO_PATH=